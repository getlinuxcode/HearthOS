#!/bin/bash
# Session console : gamescope plein écran sur le TTY, avec l'interface Hearth dedans.
# Lancée automatiquement à la connexion sur tty1 (voir /etc/skel/.bash_profile).

DATA="$HOME/.local/share/hearth"
mkdir -p "$DATA"

# Une mise à jour installée apporte sa propre version de ce script : on lui passe la main.
# (Ainsi l'ISO n'a jamais besoin d'être refaite pour faire évoluer la session.)
if [ -z "${HEARTH_DELEGATED:-}" ] && [ -f "$DATA/current/system/hearth-session" ]; then
  export HEARTH_DELEGATED=1
  exec bash "$DATA/current/system/hearth-session"
fi
LOG="$DATA/session.log"
exec >>"$LOG" 2>&1
echo "=== session $(date)"

# Réglages d'affichage écrits par le daemon (Réglages → Affichage)
[ -f "$DATA/display.env" ] && . "$DATA/display.env"

export HEARTH_MODE
[ -d /run/archiso ] && HEARTH_MODE=live || HEARTH_MODE=installed

# Machine virtuelle : pas de Vulkan accéléré, gamescope ne peut pas afficher.
# On passe directement par cage (compositeur kiosque wlroots, rendu OpenGL).
if systemd-detect-virt -q; then
  echo "machine virtuelle détectée : session cage"
  export WLR_NO_HARDWARE_CURSORS=1
  # Le pilote virtuel (vmwgfx) refuse le partage de tampons dmabuf entre clients et
  # compositeur : on compose en logiciel et l'interface passe par X11 (Xwayland).
  export WLR_RENDERER=pixman
  export LIBGL_ALWAYS_SOFTWARE=1
  export HEARTH_FORCE_X11=1
  exec cage -s -- /usr/local/bin/hearth-inner
fi

# Pas de -e (mode Steam) : dans ce mode gamescope n'affiche que les fenêtres désignées par le
# client Steam ; sans lui l'écran reste sur le TTY (constaté sur Intel Arc A310 + TV 4K).
ARGS=(-f)
[ -n "${HEARTH_W:-}" ] && ARGS+=(-W "$HEARTH_W" -H "$HEARTH_H")
[ -n "${HEARTH_REFRESH:-}" ] && ARGS+=(-r "$HEARTH_REFRESH")
[ "${HEARTH_VRR:-0}" = 1 ] && ARGS+=(--adaptive-sync)
[ "${HEARTH_HDR:-0}" = 1 ] && ARGS+=(--hdr-enabled)
case "${HEARTH_UPSCALER:-off}" in
  fsr) ARGS+=(-F fsr) ;;
  nis) ARGS+=(-F nis) ;;
  integer) ARGS+=(-S integer) ;;
esac

if gamescope "${ARGS[@]}" -- /usr/local/bin/hearth-inner; then
  exit 0
fi
echo "gamescope indisponible, repli sur cage"
exec cage -s -- /usr/local/bin/hearth-inner
